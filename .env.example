# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.
# Solo variables VITE_* (públicas, viajan al navegador). Secretos van en Supabase/Vercel, jamás aquí.
# Solo hay un Supabase: el de la nube (Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
# La clave pública («publishable» / anon). NUNCA la clave de servicio.
VITE_SUPABASE_ANON_KEY=

# local | staging | production   («local» = tu máquina de desarrollo, no un Supabase local)
VITE_APP_ENV=local
VITE_SITE_URL=http://localhost:5173

# --- Solo para las pruebas contra la nube y `npm run admin:promote` (archivo aparte: .env.e2e, también ignorado por git) ---
# SUPABASE_SERVICE_ROLE_KEY=      # clave secreta (sb_secret_… o service_role); NUNCA en .env.local ni en el chat
# SUPABASE_DB_PASSWORD=           # contraseña de la base, TAL CUAL (para pgTAP y el SQL de las pruebas); el host sale de la URL
