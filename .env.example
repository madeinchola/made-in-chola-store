# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local al repo.
# Solo variables VITE_* (públicas, viajan al navegador). Secretos van en Supabase/Vercel, jamás aquí.

# Supabase local: `supabase start` imprime la URL y la anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# local | staging | production
VITE_APP_ENV=local
VITE_SITE_URL=http://localhost:5173
